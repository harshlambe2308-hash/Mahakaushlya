# ---------------------------------------------------------------------------
# MahaKaushalya — merged backend environment (SINGLE source of truth)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Supabase (used only when DATA_PROVIDER=supabase)
DATA_PROVIDER=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=mahakaushalya_dev_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# CORS — explicit frontend origins, never a wildcard in production.
# VS Code Live Server default + common dev ports.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150
AUTH_RATE_LIMIT_MAX=20
