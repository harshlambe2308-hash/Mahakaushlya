# ============================================================================
# MahaKaushalya — environment template (backend: server/)
# Copy this file to server/.env and fill in real values.
#   cp .env.example server/.env
# NEVER commit the real .env.
# ============================================================================

NODE_ENV=development
PORT=5000

# memory  -> zero-config in-memory store (resets on restart; great for demo/E2E)
# supabase-> persist to Supabase Postgres (run schema.sql first)
DATA_PROVIDER=supabase

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (never '*' in production)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150
AUTH_RATE_LIMIT_MAX=20
